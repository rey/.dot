[color]
  ui = auto
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
[color "status"]
  added = green
  changed = yellow
  untracked = cyan
[user]
  name = Rey Dhuny
  email = 37158+rey@users.noreply.github.com
[push]
  default = simple
[core]
  editor = /usr/bin/vim
  excludesfile = ~/.gitignore_global
[alias]
  lg = log --color --graph --pretty=format:'%C(cyan)%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(white)<%an>%Creset' --abbrev-commit
[init]
  defaultBranch = trunk
